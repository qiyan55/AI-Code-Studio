<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!--
      用户气泡（靠右）：绿色描边 + 半透明绿底。
      右下角做成方角（0dp），其余三角保持 12dp 圆角，
      形成指向右下角的气泡尾，与代码绘制的 ChatPanel 版本保持一致。
    -->
    <solid android:color="#1A26D962" />
    <stroke
        android:width="1dp"
        android:color="#26D962" />
    <corners
        android:radius="12dp"
        android:bottomRightRadius="0dp" />
    <padding
        android:top="10dp"
        android:bottom="10dp"
        android:left="14dp"
        android:right="14dp" />
</shape>

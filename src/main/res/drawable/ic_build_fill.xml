<?xml version="1.0" encoding="utf-8"?>
<!--
  满幅版锤子：专供编译按钮大圆使用。
  原 ic_build 图形（含描边 2.2 外扩 1.1）实际边界 x∈[2.9,20.3] y∈[3.7,21.1]，
  即 17.4×17.4，只占 24dp 画布的 72.5%，四周自带一圈空白。
  这里把 viewport 收到 18 并用 group 平移 -3.2 / -4.0，
  使图形填满画布（17.4/18 ≈ 96.7%），同样的 setBounds 下锤子能大出约 1/3。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="18"
    android:viewportHeight="18">
    <group
        android:translateX="-3.2"
        android:translateY="-4.0">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M11.2 4.8l8 8-2.4 2.4-8-8 2.4-2.4z" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M8.6 12.6L4 17.2l2.8 2.8 4.6-4.6" />
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- AI 气泡：蓝色描边（与主题色一致）+ 半透明蓝底，左上角小圆角表示靠左 -->
    <solid android:color="#1A3D9BFF" />
    <stroke
        android:width="1dp"
        android:color="#3D9BFF" />
    <corners
        android:radius="12dp"
        android:topLeftRadius="4dp" />
    <padding
        android:top="10dp"
        android:bottom="10dp"
        android:left="14dp"
        android:right="14dp" />
</shape>
